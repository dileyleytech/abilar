# Copie para .env.local e preencha. Valores públicos (vão no bundle).
# São os MESMOS NEXT_PUBLIC_SUPABASE_* do app web (.env.local da raiz).
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...sua-anon-key...

# Backend Next (endpoints /api/mobile/*). Em DEV use o IP da sua máquina na LAN
# + a porta do dev (3001). Descubra com: ipconfig getifaddr en0
EXPO_PUBLIC_API_URL=http://192.168.0.10:3001
