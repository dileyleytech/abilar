{
  "name": "abilar",
  "version": "0.0.0",
  "private": true,
  "description": "Abilar — marketplace de marcenaria sob demanda (web Next.js, deploy Cloudflare Workers via OpenNext).",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --turbopack -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && pnpm -r --filter=./packages/* --filter=./db run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @abilar/db run generate",
    "db:migrate": "pnpm --filter @abilar/db run migrate",
    "db:seed:admin": "pnpm --filter @abilar/db run seed:admin"
  },
  "dependencies": {
    "@abilar/ai-vision": "workspace:*",
    "@abilar/db": "workspace:*",
    "@abilar/pricing": "workspace:*",
    "@abilar/shared": "workspace:*",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.29.0",
    "next": "^15.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@next/eslint-plugin-next": "^16.3.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.119.0"
  }
}
