# .env.example — copie para .env.local e preencha. NUNCA commite o .env real.
# Em produção, os segredos vão via `wrangler secret put`, não neste arquivo.

# App
APP_URL=http://localhost:3000
ENVIRONMENT=development

# Gemini (único provedor de LLM: texto, NLU e imagem)
GEMINI_API_KEY=

# Supabase — públicas (client; NEXT_PUBLIC_* são inlined no bundle do app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase — server
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Conexão DIRETA (porta 5432) — usada pelo Hyperdrive e pelas migrations do Drizzle.
# NÃO usar a string do pooler (6543) com Hyperdrive.
DATABASE_URL=postgresql://postgres:[SENHA]@db.[REF].supabase.co:5432/postgres

# Asaas (pagamento: split, escrow, saque Pix)
ASAAS_API_KEY=
ASAAS_WEBHOOK_SECRET=

# OTP por telefone (escolher um provedor: Twilio, Zenvia, MessageBird...)
SMS_PROVIDER=twilio
SMS_PROVIDER_TOKEN=
SMS_PROVIDER_FROM=

# (Cloudflare bindings — Hyperdrive/R2/Queues/Browser — são configurados no wrangler.toml,
#  não aqui. IDs reais entram no wrangler.toml.)
